{
  "name": "canaryprobe",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Synthetic checks as code - test in CI, probe production later with the agent.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write .",
